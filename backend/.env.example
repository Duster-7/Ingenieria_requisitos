# ---- Servidor ----
PORT=3000
CORS_ORIGIN=http://localhost:4200

# ---- Seguridad (RF-04 / RNF-02) ----
# Secreto para firmar los JWT de sesión clínica
JWT_SECRET=cambia-este-secreto
JWT_EXPIRES_IN=8h
# Clave AES-256 de 32 bytes en hexadecimal (64 caracteres). Genera una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_ENCRYPTION_KEY=
# Clave que debe enviar el gateway hospitalario en el header x-gateway-key
GATEWAY_API_KEY=gw-uci-demo-key

# ---- Persistencia ----
DATA_FILE=./data/mediguard.enc

# ---- Umbrales clínicos (RF-01 / RF-08) ----
HR_HIGH=140
HR_LOW=45
ANAPHYLAXIS_THRESHOLD=0.7

# ---- Simulador de sensores ----
SIMULATOR_ENABLED=true
SIMULATOR_INTERVAL_MS=1000
# Probabilidad (0..1) de descartar un paquete para probar la métrica RNF-05
SIMULATOR_PACKET_LOSS=0
